<?xml version="1.0"?>
<package format="3">
  <name>tb3_line_bringup</name>
  <version>0.0.1</version>
  <description>TurtleBot3 line tracing bringup with camera, line follower, and lidar yaw mux</description>
  <maintainer email="todo@todo.todo">turtlebot3_7</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>yellow_line_follower</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
